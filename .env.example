# Spring Boot no carga .env automáticamente: exportar estas variables en el shell.
SERVER_PORT=8083
# Activación explícita; mantener false hasta configurar el entorno de destino.
COMMUNITY_MONGODB_ENABLED=false
# URI sin valor ni credenciales de ejemplo. No usar Atlas real en las pruebas.
# Si la URI incluye una base, deberá ser foodly-community; también puede omitirla.
MONGODB_URI=
MONGODB_DATABASE=foodly-community
# JWT sigue desactivado por defecto. Elegir explícitamente el contrato al activar.
COMMUNITY_JWT_ENABLED=false
# iam-current: formato IAM revisado sin iss/aud. issuer-audience: contrato estricto.
IAM_JWT_CONTRACT=
# HS256: sin claves, issuer o audience reales.
# IAM_SECRET_BASE64 contendrá la misma clave acordada con IAM, codificada en Base64.
IAM_SECRET_BASE64=
IAM_ISSUER=
IAM_AUDIENCE=
# Consumidor Business inactivo por defecto; exige MongoDB replica set al activar.
COMMUNITY_BUSINESS_EVENTS_ENABLED=false
COMMUNITY_BUSINESS_MAX_ATTEMPTS=3
COMMUNITY_BUSINESS_RETRY_DELAY_MS=250
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_VIRTUAL_HOST=
RABBITMQ_SSL_ENABLED=false
